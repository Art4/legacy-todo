includes:
    - phpstan-baseline.neon
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon

parameters:
    level: 6
    paths:
        - addtodo.php
        - admin.php
        - config.php
        - db.php
        - deletetodo.php
        - edittodo.php
        - functions.php
        - src
        - includes
        - index.php
        - login.php
        - logout.php
        - old
        - todo.php
    excludePaths:
        - vendor
