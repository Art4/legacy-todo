includes:
    - phpstan-baseline.neon
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon

parameters:
    level: 5
    paths:
        - public/addtodo.php
        - public/admin.php
        - config.php
        - db.php
        - public/deletetodo.php
        - public/edittodo.php
        - functions.php
        - src
        - public/index.php
        - public/login.php
        - public/logout.php
        - old
        - public/todo.php
    excludePaths:
        - vendor

    ignoreErrors:
        -
            # PHPMD's @SuppressWarnings(PHPMD.X) annotation is not valid PHPDoc
            # for PHPStan's parser; we keep it on Page.php and Bootstrap.php so
            # PHPMD's structural findings (wide seam interface, module-locator
            # accessor count) are documented-as-suppressed rather than misread
            # as parse errors.
            identifier: phpDoc.parseError
            path: src/Page.php
        -
            identifier: phpDoc.parseError
            path: src/Bootstrap.php
