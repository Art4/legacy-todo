includes:
    - phpstan-baseline.neon
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon

parameters:
    level: 5
    paths:
        - public/addtodo.php
        - public/admin.php
        - public/deletetodo.php
        - public/edittodo.php
        - src
        - public/index.php
        - public/login.php
        - public/logout.php
        - public/todo.php
    excludePaths:
        - vendor

    ignoreErrors:
        -
            # PHPMD's @SuppressWarnings(PHPMD.X) annotation is not valid PHPDoc
            # for PHPStan's parser; we keep it on Bootstrap.php so PHPMD's
            # structural finding (module-locator accessor count) is
            # documented-as-suppressed rather than misread as a parse error.
            identifier: phpDoc.parseError
            path: src/Bootstrap.php
        -
            # Same suppression for Auth (session-CSRF contract grew the public
            # method count past PHPMD's threshold by design, issue #202).
            identifier: phpDoc.parseError
            path: src/Auth.php
        -
            # Same suppression for Todo (a value object's accessor count and
            # constructor arity are the shape itself; see the class docblock).
            identifier: phpDoc.parseError
            path: src/Todo.php
