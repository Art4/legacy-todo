{
    "name": "art4/legacy-todo",
    "description": "Bewusst schlechte PHP-5.6-Legacy-Anwendung To-Do-Liste – Testdaten für Refactoring-Suite.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^5.7",
        "phpstan/phpstan": "^1.0"
    },
    "autoload-dev": {
        "classmap": [
            "tests/Legacy/"
        ]
    },
    "config": {
        "platform": {
            "php": "5.6.40"
        },
        "audit": {
            "block-insecure": false
        }
    }
}
