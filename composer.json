{
    "name": "art4/legacy-todo",
    "description": "To-do list application with a PHP 5.6 legacy codebase, under active modernization",
    "type": "project",
    "license": "proprietary",
    "autoload": {
        "psr-4": {
            "Art4\\LegacyTodo\\": "src/"
        }
    },
    "require": {
        "php": ">=8.3.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpunit/phpunit": "^11",
        "rector/rector": "^2.6",
        "vimeo/psalm": "^6.16"
    },
    "autoload-dev": {
        "classmap": [
            "tests/Legacy/",
            "tests/Unit/"
        ]
    }
}
